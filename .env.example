# Copy to .env for local development (host-side addresses).
# Inside docker compose, services override these with internal addresses (see docker-compose.yml header).

POSTGRES_USER=bytearena
POSTGRES_PASSWORD=bytearena
POSTGRES_DB=bytearena
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgres://bytearena:bytearena@localhost:5432/bytearena
KAFKA_BROKERS=localhost:29092
SUBMISSION_GRPC_ADDR=localhost:50051

GRPC_PORT=50051
GATEWAY_PORT=4000
LOG_LEVEL=info

# Runner
RUNNER_SESSION_TIMEOUT_MS=10000
SANDBOX_STARTUP_ALLOWANCE_MS=500
SANDBOX_OUTPUT_CAP_BYTES=65536

# Linux only, for the runner container to reach the Docker socket as non-root
DOCKER_GID=999
